# Conexão com o PostgreSQL
DATABASE_URL="postgresql://workshop:workshop123@localhost:5432/workshop?schema=public"

# Segredo para assinar a sessão do admin (mín. 32 caracteres).
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-gerado-com-openssl"

# Usuário organizador criado pelo seed (npx prisma db seed)
ADMIN_EMAIL="organizador@escola.com"
ADMIN_PASSWORD="troque-esta-senha"
